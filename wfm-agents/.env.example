# WFM_OPENAI_API_KEY=sk-xxx
# WFM_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# WFM_AGENT_MODEL=qwen-plus
# WFM_AGENT_FALLBACKS=qwen-turbo,qwen-max
# WFM_AGENT_API=responses
#
# # DeepSeek
# WFM_OPENAI_API_KEY=sk-xxx
# WFM_OPENAI_BASE_URL=https://api.deepseek.com/v1
# WFM_AGENT_MODEL=deepseek-chat
# WFM_AGENT_FALLBACKS=deepseek-reasoner
#
# # 官方 OpenAI
# WFM_OPENAI_API_KEY=sk-xxx
# WFM_OPENAI_BASE_URL=
# WFM_AGENT_MODEL=gpt-4.1-mini
# WFM_AGENT_FALLBACKS=gpt-4o-mini

# ---- Claude Code CLI 后端 -----------------------------------------------
# 选择 Claude Code 后端时，用于覆盖 --model 参数（默认 sonnet）
# WFM_CLAUDE_MODEL=sonnet

