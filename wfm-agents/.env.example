# wfm-agents 本地开发环境变量样板。
# 用法：拷贝到同目录下的 .env，然后填入真实的 API Key。`.env` 已被 .gitignore，不进版本控制。
#
# 加载机制：wfm_agents.server.create_app() 在启动时自动 `load_dotenv()`，
# 优先级低于已有的 shell env（即 shell export 的值会覆盖 .env 里的同名 key）。
# 启动后改 .env 需重启进程或 uvicorn --reload 触发热重载。

# ---- SDK-native 对话 runner（ARCH_AGENT_SDK_NATIVE §5）--------------------
# 唯一上游：wfm_agents.agent.runner 直连 openai-python。
# 下面所有 WFM_AGENT_* 变量都被 agent/config.py 读取。

# 智谱 GLM（推荐 GLM-5.1）—— OpenAI 兼容端点
WFM_OPENAI_API_KEY=
WFM_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
WFM_AGENT_MODEL=glm-5.1
# 主模型不可用 / 上游不支持时，按顺序尝试这些后备模型（逗号分隔，可空）
WFM_AGENT_FALLBACKS=

# responses | chat —— 智谱 GLM 用 chat（Responses API 可能不支持）
WFM_AGENT_API=chat
# SDK 内置重试次数（429 / 网络抖动）
WFM_AGENT_RETRIES=2
# 单次请求总超时秒数
WFM_AGENT_TIMEOUT=120
# 默认温度；CadReviewRecipe 等会覆盖（审图固定 0.2）
WFM_AGENT_TEMP=0.3
# function calling 工具循环最大轮次
WFM_AGENT_MAX_TOOL_ROUNDS=8
# 内存 SessionStore 的 TTL（秒）
WFM_AGENT_SESSION_TTL_SEC=3600
# 多模态视觉总开关；本期默认关闭
WFM_AGENT_ALLOW_IMAGE=false

# ---- 备用上游示例（取消注释切换） -----------------------------------------
